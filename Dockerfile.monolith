# syntax=docker/dockerfile:1.7

FROM gradle:9.1.0-jdk17 AS kotlin-builder
USER root
WORKDIR /workspace/backend-kt
COPY backend-kt/ ./
RUN gradle :monolith:app:shadowJar --no-daemon --build-cache --project-cache-dir /workspace/.gradle-project-cache

FROM node:22-bookworm-slim AS node-builder
WORKDIR /workspace/db-service
COPY js/services/db-service/package*.json ./
RUN npm ci
COPY js/services/db-service/ ./
RUN npm run build \
    && npm prune --omit=dev

FROM node:22-bookworm-slim AS migration-cli
WORKDIR /opt/drizzle
RUN npm init --yes \
    && npm install --omit=dev --save-exact drizzle-kit@0.31.9

FROM node:22-bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl gettext-base nginx openjdk-17-jre-headless tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system monolith \
    && useradd --system --gid monolith --home-dir /opt/monolith monolith \
    && mkdir -p /opt/monolith/db-service /etc/nginx/templates /tmp/nginx/client_body /tmp/nginx/proxy \
    && chown -R monolith:monolith /opt/monolith /tmp/nginx /var/lib/nginx /var/log/nginx

COPY --from=kotlin-builder --chown=monolith:monolith /workspace/backend-kt/monolith/app/build/libs/*-all.jar /opt/monolith/backend-monolith.jar
COPY --from=node-builder --chown=monolith:monolith /workspace/db-service/dist /opt/monolith/db-service/dist
COPY --from=node-builder --chown=monolith:monolith /workspace/db-service/node_modules /opt/monolith/db-service/node_modules
COPY --from=migration-cli --chown=monolith:monolith /opt/drizzle/node_modules /opt/monolith/db-service/node_modules
COPY --from=node-builder --chown=monolith:monolith /workspace/db-service/package.json /opt/monolith/db-service/package.json
COPY --from=node-builder --chown=monolith:monolith /workspace/db-service/drizzle /opt/monolith/db-service/drizzle
COPY --from=node-builder --chown=monolith:monolith /workspace/db-service/drizzle.config.ts /opt/monolith/db-service/drizzle.config.ts
COPY --chown=monolith:monolith deploy/monolith/nginx.conf.template /etc/nginx/templates/monolith.conf.template
COPY --chown=monolith:monolith deploy/monolith/entrypoint.sh deploy/monolith/healthcheck.sh /usr/local/bin/
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/healthcheck.sh

ENV MONOLITH_HOST=127.0.0.1 \
    MONOLITH_INTERNAL_PORT=8081 \
    DB_SERVICE_HOST=127.0.0.1 \
    PORT=3008 \
    KEYCLOAK_REALM=dsbuilder \
    GATEWAY_PROXY_TIMEOUT_SECONDS=300 \
    DOCUMENTATION_MAX_REQUEST_SIZE=101m \
    MONOLITH_SHUTDOWN_TIMEOUT_SECONDS=10

WORKDIR /opt/monolith

USER monolith
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 CMD ["/usr/local/bin/healthcheck.sh"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
