# Repository verification manifest. It is sourced by tools/verify after the
# registration functions below have been defined there.

verification_version 2

base_ref origin/dev
base_ref dev
base_ref origin/main
base_ref main
base_ref origin/master
base_ref master

forbidden_path_segment node_modules
forbidden_path_segment build
forbidden_path_segment .gradle
forbidden_path_segment .kotlin
forbidden_path_segment .sdds
forbidden_file_name .env
forbidden_file_prefix .env.

openspec_changes_path openspec/changes

process_path tools
process_path .verification
process_path .agents/workflows
process_path .agents/skills/dsbuilder-task-workflow
process_path .claude/skills/dsbuilder-task-workflow
process_command . "bash -n tools/task tools/verify tools/strictacode"

protected_path \
  architecture-tests \
  architecture-tests \
  "backend-kt/architecture-tests|frontend-kt/architecture-tests" \
  "backend-kt/architecture-tests|frontend-kt/architecture-tests|LayerArchitectureTest"

protected_path \
  strictacode-policy \
  strictacode-policy \
  "backend-kt/.strictacode.yml|frontend-kt/.strictacode.yml|js/apps/client/.strictacode.yml|js/cli/.strictacode.yml|js/services/db-service/.strictacode.yml|tools/strictacode|tools/strictacode-requirements.txt|.verification/strictacode-baseline" \
  "strictacode|strictacode-baseline|.strictacode.yml"

protected_path \
  agent-process \
  agent-process \
  "tools/task|tools/verify|.verification/config|.agents/workflows|.agents/skills/dsbuilder-task-workflow|.claude/skills/dsbuilder-task-workflow" \
  "agent workflow|tools/task|tools/verify|.verification/config|dsbuilder-task-workflow"

contour \
  backend-kotlin \
  backend-kt \
  backend-kt \
  "./gradlew verifyFast" \
  "./gradlew verifyFull" \
  "../tools/strictacode audit backend ." \
  "../tools/strictacode compare backend ."

contour \
  frontend-kotlin \
  frontend-kt \
  frontend-kt \
  "./gradlew verifyFast" \
  "./gradlew verifyFull" \
  "../tools/strictacode audit frontend ." \
  "../tools/strictacode compare frontend ."

contour \
  javascript \
  js \
  js \
  "npm run verify:fast" \
  "npm run verify:full" \
  "../tools/strictacode audit-set javascript-client:apps/client javascript-cli:cli javascript-db-service:services/db-service" \
  "../tools/strictacode compare-set javascript-client:apps/client javascript-cli:cli javascript-db-service:services/db-service"
