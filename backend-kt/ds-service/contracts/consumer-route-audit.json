{
  "includedConsumers": {
    "frontend-kt": [
      "/design-systems/**",
      "/tokens/**",
      "/tenants/**",
      "/palette/**",
      "/components/**",
      "/component-config/import",
      "/component-config/export",
      "/component-config/web-adapter"
    ],
    "js/apps/client": [
      "/design-systems/**",
      "/tenants/**",
      "/palette"
    ]
  },
  "excludedButUsed": {
    "frontend-kt": [
      "/legacy/design-systems/{name}/component-configs"
    ],
    "js/apps/client": [
      "/legacy/design-systems/create",
      "/legacy/design-systems/{name}/update",
      "/legacy/design-systems/{name}/theme-data",
      "/legacy/design-systems/{name}/component-configs",
      "/legacy/design-systems/{name}/tenant-params",
      "/legacy/design-systems/{name}/download-theme"
    ]
  },
  "compatibilityFallbacks": [
    "/api/projects/{projectId}/ds/legacy/**"
  ],
  "decision": "Keep authenticated legacy project routes on db-service; the only administrative route is the API-meta import served by ds-service; no consumer contract changes are required for included routes."
}
