# Local Keycloak admin username used by docker-compose.local.yml and start-local.sh bootstrap.
KEYCLOAK_ADMIN=admin
# Local Keycloak admin password used by docker-compose.local.yml and start-local.sh bootstrap.
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional custom Docker image tag for local auth-helper build.
AUTH_HELPER_IMAGE=auth-helper:dev
# Optional custom Docker image tag for local projects-service build.
PROJECTS_SERVICE_IMAGE=projects-service:dev

# Mode used by auth-helper to talk to downstream project access source.
PROJECT_ACCESS_MODE=http
# Default project role fallback for local auth checks.
PROJECT_ACCESS_DEFAULT_ROLE=viewer
# Shared key for auth-helper -> projects-service internal API in local stack.
PROJECTS_INTERNAL_API_KEY=local-projects-internal-key

# Base URL of Keycloak Admin API as seen by projects-service in local docker network.
PROJECTS_IDENTITY_KEYCLOAK_BASE_URL=http://keycloak:8080
# Realm used by local projects-service for Keycloak lookup.
PROJECTS_IDENTITY_KEYCLOAK_REALM=dsbuilder
# Confidential client id bootstrapped by start-local.sh for projects-service lookup.
PROJECTS_IDENTITY_KEYCLOAK_CLIENT_ID=projects-service
# Confidential client secret bootstrapped by start-local.sh for projects-service lookup.
PROJECTS_IDENTITY_KEYCLOAK_CLIENT_SECRET=projects-service-secret
