{
  "realm": "dsbuilder",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Default DS Builder user"
      },
      {
        "name": "system_admin",
        "description": "Platform administrator"
      },
      {
        "name": "compose_preview_publisher",
        "description": "Publishes Compose preview plugin builds (service account of the plasma-android CI)"
      }
    ]
  },
  "defaultRoles": [
    "user"
  ],
  "clients": [
    {
      "clientId": "dsbuilder-api",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3002/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3002",
        "http://localhost:8080"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "dsbuilder-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dsbuilder-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dsbuilder-studio-plugin",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:*",
        "http://localhost:*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "login_theme": "dsbuilder"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "dsbuilder-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dsbuilder-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dsbuilder-preview-publisher",
      "name": "DS Builder Compose preview publisher",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-preview-publisher-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "dsbuilder-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dsbuilder-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user@example.com",
      "email": "user@example.com",
      "firstName": "User",
      "lastName": "First",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "user2@example.com",
      "email": "user2@example.com",
      "firstName": "User",
      "lastName": "Two",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "admin@example.com",
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "system_admin"
      ]
    },
    {
      "username": "service-account-dsbuilder-preview-publisher",
      "enabled": true,
      "serviceAccountClientId": "dsbuilder-preview-publisher",
      "realmRoles": [
        "compose_preview_publisher"
      ]
    }
  ]
}
