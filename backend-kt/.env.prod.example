# Public port of nginx gateway on the server.
GATEWAY_PORT=8080
# Timeout in seconds for gateway -> upstream response/request body transfer.
GATEWAY_PROXY_TIMEOUT_SECONDS=300
# Scheme used by gateway to reach db-service.
# Use "http" for internal Docker networking or host-published ports, "https" for a Coolify domain.
DB_SERVICE_UPSTREAM_SCHEME=http
# Hostname of db-service as seen from the gateway container.
# For same-host deployment, keep db-service published only on 127.0.0.1 and use host.docker.internal here.
# For a public Coolify domain, use the domain name, for example "db-service.example.com".
DB_SERVICE_UPSTREAM_HOST=host.docker.internal
# Port of db-service as seen from the gateway container.
# Use the internal container port for Docker networking, the published host port for same-host deployment,
# or 443 when routing through a public HTTPS domain.
DB_SERVICE_UPSTREAM_PORT=3008

# Scheme used by gateway to reach docs-service.
DOCS_SERVICE_UPSTREAM_SCHEME=http
# Hostname of docs-service as seen from the gateway container.
DOCS_SERVICE_UPSTREAM_HOST=host.docker.internal
# Port of docs-service as seen from the gateway container.
DOCS_SERVICE_UPSTREAM_PORT=3009

# Scheme used by gateway to reach generator-service.
GENERATOR_SERVICE_UPSTREAM_SCHEME=http
# Hostname of generator-service as seen from the gateway container.
GENERATOR_SERVICE_UPSTREAM_HOST=host.docker.internal
# Port of generator-service as seen from the gateway container.
GENERATOR_SERVICE_UPSTREAM_PORT=3010

# Scheme used by gateway to reach publisher-service.
PUBLISHER_SERVICE_UPSTREAM_SCHEME=http
# Hostname of publisher-service as seen from the gateway container.
PUBLISHER_SERVICE_UPSTREAM_HOST=host.docker.internal
# Port of publisher-service as seen from the gateway container.
PUBLISHER_SERVICE_UPSTREAM_PORT=3011

# Optional public port for direct access to Keycloak admin console.
# Admin console is also available through nginx gateway at /admin/.
# Keep 127.0.0.1 unless you intentionally need direct access outside nginx.
KEYCLOAK_ADMIN_BIND=127.0.0.1
KEYCLOAK_ADMIN_PORT=8090

# Hostname of Keycloak as seen from the gateway container.
# In this stack Keycloak runs in docker-compose, so "keycloak" is the default service name.
KEYCLOAK_UPSTREAM_HOST=keycloak
# HTTP port of Keycloak inside the docker network.
KEYCLOAK_UPSTREAM_PORT=8080
# Realm name used by the whole auth flow.
KEYCLOAK_REALM=dsbuilder
# Public OIDC client used by frontend/browser login flow.
OIDC_CLIENT_ID=dsbuilder-api
# Frontend callback URL where Keycloak redirects the browser after login.
OIDC_REDIRECT_URI=https://app.example.com/auth/callback
# Frontend origin allowed for the OIDC client in Keycloak.
OIDC_WEB_ORIGIN=https://app.example.com

# Public issuer URL that will appear in the "iss" claim of issued JWTs.
# It must use the same public gateway host that serves /realms/... and /admin/...
KEYCLOAK_ISSUER=https://api.example.com/realms/dsbuilder
# Audience expected by auth-helper when validating JWTs.
KEYCLOAK_AUDIENCE=dsbuilder-api
# URL used by auth-helper to fetch public keys for JWT verification.
# It may stay internal because backend services can talk to Keycloak over docker network.
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/dsbuilder/protocol/openid-connect/certs
# Internal URL used by the bootstrap container to configure Keycloak.
KEYCLOAK_BOOTSTRAP_URL=http://keycloak:8080

# Bootstrap admin username for Keycloak master realm.
KEYCLOAK_ADMIN=change-me-admin
# Bootstrap admin password for Keycloak master realm.
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-password
# Keycloak database vendor. Keep "postgres" for this stack.
KC_DB=postgres
# Host of external PostgreSQL used by Keycloak.
KC_DB_URL_HOST=keycloak-postgres.internal
# Port of external PostgreSQL used by Keycloak.
KC_DB_URL_PORT=5432
# Enables Keycloak health endpoints used by docker healthcheck.
KC_HEALTH_ENABLED=true
# Enables Keycloak metrics endpoint.
KC_METRICS_ENABLED=true
# Tells Keycloak to trust x-forwarded headers from nginx.
KC_PROXY_HEADERS=xforwarded
# Public hostname of Keycloak from the user's perspective.
# Use the hostname that serves /realms/... publicly.
KC_HOSTNAME=api.example.com

# Database name in external PostgreSQL used by Keycloak.
KEYCLOAK_POSTGRES_DB=keycloak
# Database username in external PostgreSQL used by Keycloak.
KEYCLOAK_POSTGRES_USER=keycloak
# Database password in external PostgreSQL used by Keycloak.
KEYCLOAK_POSTGRES_PASSWORD=change-me-keycloak-db-password

# Mode used by auth-helper to talk to downstream project access source.
# Keep "http" for the current stack.
PROJECT_ACCESS_MODE=http
# Fallback role used when auth logic needs a default project role.
PROJECT_ACCESS_DEFAULT_ROLE=viewer
# Timeout in milliseconds for auth-helper -> downstream project access checks.
PROJECT_ACCESS_TIMEOUT_MS=1500
# Shared secret for auth-helper -> projects-service internal requests.
# Generate a long random value and keep it identical in the whole stack.
PROJECTS_INTERNAL_API_KEY=replace-with-long-random-shared-key

# Database name in external PostgreSQL used by projects-service.
PROJECTS_POSTGRES_DB=projects_service
# Database username in external PostgreSQL used by projects-service.
PROJECTS_POSTGRES_USER=projects
# Database password in external PostgreSQL used by projects-service.
PROJECTS_POSTGRES_PASSWORD=change-me-projects-db-password

# Prefix used when generating project access keys.
PROJECTS_ACCESS_KEYS_PREFIX=dsb_pk
# Default TTL for generated project access keys in milliseconds.
PROJECTS_ACCESS_KEYS_DEFAULT_TTL_MS=2592000000
# Random secret length for project access keys in bytes.
PROJECTS_ACCESS_KEYS_SECRET_BYTE_LENGTH=32
# PBKDF2 iteration count for hashing project access key secrets.
PROJECTS_ACCESS_KEYS_HASH_ITERATIONS=120000
# PBKDF2 output key length in bits.
PROJECTS_ACCESS_KEYS_HASH_KEY_LENGTH_BITS=256
# Salt length in bytes for hashing project access key secrets.
PROJECTS_ACCESS_KEYS_HASH_SALT_BYTE_LENGTH=16

# Internal HTTP port of projects-service inside docker network.
PROJECTS_SERVICE_PORT=8082
# JDBC URL used by projects-service to connect to external PostgreSQL.
PROJECTS_DATABASE_URL=jdbc:postgresql://projects-postgres.internal:5432/projects_service

# Internal Keycloak base URL used by projects-service for Admin API calls.
PROJECTS_IDENTITY_KEYCLOAK_BASE_URL=http://keycloak:8080
# Realm used by projects-service when talking to Keycloak.
PROJECTS_IDENTITY_KEYCLOAK_REALM=dsbuilder
# Confidential Keycloak client id used by projects-service for user lookup.
PROJECTS_IDENTITY_KEYCLOAK_CLIENT_ID=projects-service
# Secret of the confidential Keycloak client used by projects-service.
PROJECTS_IDENTITY_KEYCLOAK_CLIENT_SECRET=replace-with-real-client-secret
# Timeout in milliseconds for projects-service -> Keycloak Admin API calls.
PROJECTS_IDENTITY_KEYCLOAK_TIMEOUT_MS=1500
