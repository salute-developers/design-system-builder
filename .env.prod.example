# Container images
REGISTRY_HOST=ghcr.io
REGISTRY_NAMESPACE=salute-developers
# DEV uses dev; PROD uses the moving release alias.
IMAGE_TAG=dev

# Public gateway configuration
GATEWAY_PROXY_TIMEOUT_SECONDS=300

# Keycloak and OIDC
KEYCLOAK_ADMIN=change-me-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-password
KEYCLOAK_REALM=dsbuilder
OIDC_CLIENT_ID=dsbuilder-api
OIDC_REDIRECT_URI=https://app.example.com/auth/callback
OIDC_WEB_ORIGIN=https://app.example.com
KEYCLOAK_ISSUER=https://api.example.com/realms/dsbuilder
KEYCLOAK_AUDIENCE=dsbuilder-api
KC_DB=postgres
KC_DB_URL_HOST=replace-with-coolify-postgres-internal-host
KC_DB_URL_PORT=5432
KC_HOSTNAME=api.example.com
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=change-me-keycloak-db-password

# Projects service
PROJECTS_INTERNAL_API_KEY=replace-with-long-random-shared-key
PROJECTS_DATABASE_URL=jdbc:postgresql://replace-with-coolify-postgres-internal-host:5432/projects_service
PROJECTS_POSTGRES_USER=projects
PROJECTS_POSTGRES_PASSWORD=change-me-projects-db-password
PROJECTS_IDENTITY_KEYCLOAK_CLIENT_ID=projects-service
PROJECTS_IDENTITY_KEYCLOAK_CLIENT_SECRET=replace-with-real-client-secret

# JS db-service (Drizzle)
DATABASE_URL=postgresql://db_service:change-me-db-password@replace-with-coolify-postgres-internal-host:5432/ds_registry
# Optional: only required by the natural-language query feature.
ZAI_API_KEY=

# Kotlin documentation-service database and object storage
DOCUMENTATION_DATABASE_URL=jdbc:postgresql://replace-with-coolify-postgres-internal-host:5432/documentation_service
DOCUMENTATION_POSTGRES_USER=documentation
DOCUMENTATION_POSTGRES_PASSWORD=change-me-documentation-db-password
DOCUMENTATION_S3_ENDPOINT=https://s3.example.com
DOCUMENTATION_S3_REGION=us-east-1
DOCUMENTATION_S3_BUCKET=documentation-bundles
DOCUMENTATION_S3_ACCESS_KEY=change-me-s3-access-key
DOCUMENTATION_S3_SECRET_KEY=change-me-s3-secret-key
DOCUMENTATION_S3_PATH_STYLE_ACCESS=false
DOCUMENTATION_S3_PREFIX=raw
DOCUMENTATION_PUBLICATION_S3_PREFIX=published

# JS documentation-generator object storage
AWS_ACCESS_KEY_ID=change-me-s3-access-key
AWS_SECRET_ACCESS_KEY=change-me-s3-secret-key
AWS_ENDPOINT=s3.example.com
AWS_REGION=us-east-1
AWS_S3_BUCKET=documentation-bundles
