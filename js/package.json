{
  "name": "ds-builder",
  "version": "1.0.0",
  "description": "Design System Builder Application.",
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "cd apps/client && npm run dev",
    "dev:compose-plugin": "cd apps/client && npm run dev:compose-plugin",
    "build": "npm run build:client",
    "build:client": "cd apps/client && npm run build",
    "test:cli": "npm --prefix cli run typecheck && npm --prefix cli test",
    "verify:fast": "npm run build && npm run test:cli",
    "verify:full": "npm run verify:fast",
    "prepare": "cd .. && husky js/.husky"
  },
  "devDependencies": {
    "@babel/parser": "7.28.4",
    "@babel/traverse": "7.28.4",
    "@eslint/js": "^9.30.1",
    "@types/node": "24.13.3",
    "concurrently": "^8.2.2",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "9.1.7",
    "prettier": "^3.4.2",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.36.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  }
}
