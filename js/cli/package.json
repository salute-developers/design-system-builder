{
    "name": "@sdds/design-system-builder-cli",
    "type": "module",
    "scripts": {
        "generate:theme": "tsx --env-file-if-exists=../.env src/theme.ts",
        "generate:components": "tsx --env-file-if-exists=../.env src/components.ts",
        "generate:ds": "tsx --env-file-if-exists=../.env src/ds.ts",
        "generate:api-meta": "tsx src/generate-api-meta.ts",
        "test": "tsx --test src/*.test.ts",
        "typecheck": "tsc -p .",
        "import:plasma": "tsx src/import-plasma-component.ts"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/plugin-transform-react-constant-elements": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@ironkinoko/rollup-plugin-styles": "^4.0.4",
        "@linaria/rollup": "^5.0.4",
        "@rollup/plugin-babel": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@rollup/pluginutils": "^5.4.0",
        "@salutejs/plasma-new-hope": "^0.384.0-dev.0",
        "@salutejs/plasma-tokens-utils": "0.61.0",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^22.20.5",
        "@types/react": "18.0.28",
        "babel-plugin-annotate-pure-calls": "^0.4.0",
        "babel-plugin-styled-components": "1.13.2",
        "fs-extra": "^11.4.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "rollup": "^3.30.0",
        "styled-components": "5.3.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "@salutejs/plasma-tokens-utils": {
            "@salutejs/plasma-colors": "^0.16.0"
        },
        "marked": "^12.0.2",
        "react-syntax-highlighter": "npm:empty-npm-package@1.0.0"
    }
}
