{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
    "exclude": [".sdds", "output", "result-*", "src/generator/templates", "src/generator/constants"]
}
