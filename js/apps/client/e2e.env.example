# Скопируйте в .env.e2e.local рядом с package.json и заполните логин/пароль.
# .env.e2e.local автоматически читается тестом и исключён из Git.
# Адреса и clientId необязательны: ниже значения по умолчанию готового локального стенда.
# Для другого стенда раскомментируйте и измените адреса/clientId; удалённый требует HTTPS.
# DSB_E2E_CLIENT_BASE_URL=http://localhost:3002/
# DSB_E2E_GATEWAY_BASE_URL=http://localhost:8080/
# DSB_E2E_CLIENT_ID=dsbuilder-api
DSB_E2E_USERNAME=
DSB_E2E_PASSWORD=
DSB_E2E_ALLOW_MUTATIONS=true
# Необязательно: имя собственного выделенного проекта (создаётся при отсутствии).
# DSB_E2E_PROJECT_NAME=E2E Automation
