{
    "name": "figma-plugin",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm run build:main -- --mode development --watch & vite build --mode development --watch",
        "build": "tsc -b && npm run build:ui && npm run build:main",
        "build:dev": "tsc -b && vite build --mode development && npm run build:main -- --mode development",
        "build:ui": "vite build",
        "build:main": "vite build --config vite.main.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint ."
    },
    "dependencies": {
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "devDependencies": {
        "@figma/plugin-typings": "1.142.0",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.3",
        "@types/node": "24.10.1",
        "@types/react": "18.3.23",
        "@types/react-dom": "18.3.7",
        "@vitejs/plugin-react-swc": "3.10.1",
        "jsdom": "27.4.0",
        "typescript": "5.8.3",
        "vite": "6.3.5",
        "vite-plugin-singlefile": "2.3.3",
        "vitest": "4.1.11"
    }
}
