{
    "compilerOptions": {
        "types": ["@figma/plugin-typings", "vitest/globals"],
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.main.tsbuildinfo",
        "target": "ES2017",
        "lib": ["ES2020"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src/main", "src/shared"]
}
