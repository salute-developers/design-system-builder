#!/usr/bin/env bash
set -euo pipefail

PROGRAM_NAME="${0##*/}"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
MANIFEST="${ROOT:+$ROOT/.verification/config}"

log() {
  echo "[$PROGRAM_NAME] $*"
}

fail() {
  echo "[$PROGRAM_NAME] $*" >&2
  exit 1
}

[[ -n "$ROOT" ]] || fail "Run this command inside a Git repository"
[[ -f "$MANIFEST" ]] || fail "Verification manifest not found: .verification/config"

MANIFEST_VERSION=""
BASE_REFS=()
FORBIDDEN_PATH_SEGMENTS=()
FORBIDDEN_FILE_NAMES=()
FORBIDDEN_FILE_PREFIXES=()
OPEN_SPEC_CHANGES_PATH=""
PROCESS_PATHS=()
PROCESS_COMMANDS=()
PROTECTED_PATHS=()
CONTOURS=()

verification_version() { MANIFEST_VERSION="$1"; }
base_ref() { BASE_REFS+=("$1"); }
forbidden_path_segment() { FORBIDDEN_PATH_SEGMENTS+=("$1"); }
forbidden_file_name() { FORBIDDEN_FILE_NAMES+=("$1"); }
forbidden_file_prefix() { FORBIDDEN_FILE_PREFIXES+=("$1"); }
openspec_changes_path() { OPEN_SPEC_CHANGES_PATH="$1"; }
process_path() { PROCESS_PATHS+=("$1"); }
process_command() { PROCESS_COMMANDS+=("$1"$'\t'"$2"); }
protected_path() { PROTECTED_PATHS+=("$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"); }
contour() { CONTOURS+=("$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\t'"$5"$'\t'"$6"$'\t'"$7"); }

# shellcheck source=/dev/null
source "$MANIFEST"

[[ "$MANIFEST_VERSION" == "2" ]] || fail "Unsupported verification manifest version: $MANIFEST_VERSION"
[[ -n "$OPEN_SPEC_CHANGES_PATH" ]] || fail "OpenSpec changes path is missing from verification manifest"

usage() {
  cat <<'USAGE'
Usage:
  tools/verify <fast|full|audit|policy> [options]

Modes:
  fast    Run configured FAST commands for changed repository contours.
  full    Run FULL commands and Strictacode compare gates.
  audit   Write Strictacode reports without changing baselines.
  policy  Check protected paths only.

Options:
  --base REF                   Compare with this task base ref.
  --change NAME                Approved OpenSpec Change for protected-path policy.
  --allow-protected PERMISSION Explicitly allow one protected-path permission.
  --all                        Run every configured contour.
  --dry-run                    Print commands without running them.

Environment:
  DSBUILDER_VERIFY_BASE  Base ref used when --base is omitted.
USAGE
}

mode="${1:-}"
case "$mode" in
  fast|full|audit|policy) shift ;;
  --help|-h|help|"") usage; exit 0 ;;
  *) fail "Expected mode 'fast', 'full', 'audit', or 'policy', got: $mode" ;;
esac

base="${DSBUILDER_VERIFY_BASE:-}"
change_name=""
dry_run="false"
all_contours="false"
allowed_permissions=("")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base)
      [[ -n "${2:-}" ]] || fail "--base requires a value"
      base="$2"
      shift 2
      ;;
    --change)
      [[ -n "${2:-}" ]] || fail "--change requires a value"
      change_name="$2"
      shift 2
      ;;
    --allow-protected)
      [[ -n "${2:-}" ]] || fail "--allow-protected requires a value"
      allowed_permissions+=("$2")
      shift 2
      ;;
    --all)
      all_contours="true"
      shift
      ;;
    --dry-run)
      dry_run="true"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *) fail "Unknown option: $1" ;;
  esac
done

ref_exists() {
  git -C "$ROOT" rev-parse --verify --quiet "$1^{commit}" >/dev/null
}

detect_base() {
  local branch configured candidate
  branch="$(git -C "$ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [[ -n "$branch" ]]; then
    configured="$(git -C "$ROOT" config --get "branch.$branch.dsbuilderBase" 2>/dev/null || true)"
    if [[ -n "$configured" ]]; then
      echo "$configured"
      return
    fi
  fi
  for candidate in "${BASE_REFS[@]}"; do
    if ref_exists "$candidate"; then
      echo "$candidate"
      return
    fi
  done
  echo "HEAD"
}

[[ -n "$base" ]] || base="$(detect_base)"
ref_exists "$base" || fail "Base ref does not exist: $base"
merge_base="$(git -C "$ROOT" merge-base HEAD "$base" 2>/dev/null || git -C "$ROOT" rev-parse "$base^{commit}")"

protected_fingerprint_current() {
  local paths_spec="$1"
  local paths=()
  local file blob
  IFS='|' read -r -a paths <<< "$paths_spec"
  {
    git -C "$ROOT" ls-files --cached --others --exclude-standard -- "${paths[@]}" |
      LC_ALL=C sort | while IFS= read -r file; do
      if [[ -L "$ROOT/$file" ]]; then
        blob="$(printf '%s' "$(readlink "$ROOT/$file")" | git -C "$ROOT" hash-object --stdin)"
        printf '%s %s\n' "$blob" "$file"
      elif [[ -f "$ROOT/$file" ]]; then
        printf '%s %s\n' "$(git -C "$ROOT" hash-object "$ROOT/$file")" "$file"
      else
        printf 'missing %s\n' "$file"
      fi
    done
  } | git -C "$ROOT" hash-object --stdin
}

protected_fingerprint_ref() {
  local ref="$1"
  local paths_spec="$2"
  local paths=()
  local file
  IFS='|' read -r -a paths <<< "$paths_spec"
  {
    git -C "$ROOT" ls-tree -r --name-only "$ref" -- "${paths[@]}" |
      LC_ALL=C sort | while IFS= read -r file; do
      printf '%s %s\n' "$(git -C "$ROOT" rev-parse "$ref:$file")" "$file"
    done
  } | git -C "$ROOT" hash-object --stdin
}

permission_present() {
  local expected="$1"
  local permission
  for permission in "${allowed_permissions[@]}"; do
    [[ "$permission" != "$expected" ]] || return 0
  done
  return 1
}

openspec_authorizes() {
  local ref="$1"
  local current_change="$2"
  local markers_spec="$3"
  [[ -n "$current_change" ]] || return 1

  local markers=()
  local grep_args=(grep -F -i -q)
  local marker archived_name
  local candidate_paths=("$OPEN_SPEC_CHANGES_PATH/$current_change")
  IFS='|' read -r -a markers <<< "$markers_spec"
  for marker in "${markers[@]}"; do
    grep_args+=(-e "$marker")
  done
  while IFS= read -r archived_name; do
    [[ "$archived_name" == *-"$current_change" ]] || continue
    candidate_paths+=("$OPEN_SPEC_CHANGES_PATH/archive/$archived_name")
  done < <(git -C "$ROOT" ls-tree -d --name-only "$ref:$OPEN_SPEC_CHANGES_PATH/archive" 2>/dev/null || true)

  git -C "$ROOT" "${grep_args[@]}" "$ref" -- "${candidate_paths[@]}" 2>/dev/null
}

check_protected_policy() {
  local record name permission paths_spec markers_spec baseline current
  for record in "${PROTECTED_PATHS[@]}"; do
    IFS=$'\t' read -r name permission paths_spec markers_spec <<< "$record"
    baseline="$(protected_fingerprint_ref "$merge_base" "$paths_spec")"
    current="$(protected_fingerprint_current "$paths_spec")"
    [[ "$current" != "$baseline" ]] || continue
    if permission_present "$permission"; then
      log "Protected path '$name' explicitly authorized"
      continue
    fi
    if openspec_authorizes HEAD "$change_name" "$markers_spec"; then
      log "Protected path '$name' authorized by approved OpenSpec: $change_name"
      continue
    fi
    fail "Protected path '$name' differs from task base '$base'. Pass an approved --change or explicit --allow-protected $permission."
  done
  log "PASS: protected-path policy against $base"
}

if [[ "$mode" == "fast" || "$mode" == "full" || "$mode" == "policy" ]]; then
  check_protected_policy
fi
if [[ "$mode" == "policy" ]]; then
  exit 0
fi

changed_file_list="$(mktemp "${TMPDIR:-/tmp}/dsbuilder-verify.XXXXXX")"
cleanup() { rm -f "$changed_file_list"; }
trap cleanup EXIT
{
  git -C "$ROOT" diff --name-only --diff-filter=ACMRD "$merge_base"
  git -C "$ROOT" ls-files --others --exclude-standard
} | sed '/^$/d' | sort -u > "$changed_file_list"

path_changed() {
  local configured_path="$1"
  local file
  while IFS= read -r file; do
    [[ "$file" == "$configured_path" || "$file" == "$configured_path/"* ]] && return 0
  done < "$changed_file_list"
  return 1
}

check_forbidden_files() {
  local file basename value
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    basename="${file##*/}"
    for value in "${FORBIDDEN_PATH_SEGMENTS[@]}"; do
      case "/$file/" in
        *"/$value/"*) fail "Forbidden generated or local file is part of the change: $file" ;;
      esac
    done
    for value in "${FORBIDDEN_FILE_NAMES[@]}"; do
      [[ "$basename" != "$value" ]] || fail "Forbidden generated or local file is part of the change: $file"
    done
    for value in "${FORBIDDEN_FILE_PREFIXES[@]}"; do
      [[ "$basename" != "$value"* ]] || fail "Forbidden generated or local file is part of the change: $file"
    done
  done < "$changed_file_list"
}

run_command() {
  local cwd="$1"
  local command="$2"
  if [[ "$dry_run" == "true" ]]; then
    log "DRY RUN ($cwd): $command"
    return
  fi
  log "Running in $cwd: $command"
  (cd "$ROOT/$cwd" && bash -c "$command")
}

run_argv() {
  local cwd="$1"
  shift
  if [[ "$dry_run" == "true" ]]; then
    printf '[%s] DRY RUN (%s):' "$PROGRAM_NAME" "$cwd"
    printf ' %q' "$@"
    printf '\n'
    return
  fi
  log "Running in $cwd: $*"
  (cd "$ROOT/$cwd" && "$@")
}

find_archived_change() {
  local name="$1"
  find "$ROOT/$OPEN_SPEC_CHANGES_PATH/archive" -mindepth 1 -maxdepth 1 -type d \
    -name "*-$name" -print 2>/dev/null || true
}

validate_openspec() {
  local names_file name archived
  names_file="$(mktemp "${TMPDIR:-/tmp}/dsbuilder-openspec.XXXXXX")"
  if [[ -n "$change_name" ]]; then
    printf '%s\n' "$change_name" > "$names_file"
  else
    sed -n "s#^${OPEN_SPEC_CHANGES_PATH}/\([^/]*\)/.*#\1#p" "$changed_file_list" |
      sed '/^archive$/d' | sort -u > "$names_file"
  fi

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if [[ -d "$ROOT/$OPEN_SPEC_CHANGES_PATH/$name" ]]; then
      run_argv . openspec validate "$name" --type change --strict --no-interactive
      continue
    fi
    archived="$(find_archived_change "$name")"
    [[ -n "$archived" ]] || fail "OpenSpec change not found: $name"
    [[ "$(printf '%s\n' "$archived" | sed '/^$/d' | wc -l | tr -d ' ')" == "1" ]] || \
      fail "More than one archived OpenSpec change matches: $name"
    run_argv . openspec validate --specs --strict --no-interactive
  done < "$names_file"
  rm -f "$names_file"
}

check_forbidden_files

process_changed="false"
for configured_path in "${PROCESS_PATHS[@]}"; do
  if path_changed "$configured_path"; then
    process_changed="true"
    break
  fi
done
if [[ "$process_changed" == "true" ]]; then
  for record in "${PROCESS_COMMANDS[@]}"; do
    IFS=$'\t' read -r cwd command <<< "$record"
    run_command "$cwd" "$command"
  done
fi

validate_openspec

for record in "${CONTOURS[@]}"; do
  IFS=$'\t' read -r name changed_path cwd fast_command full_command audit_command compare_command <<< "$record"
  [[ "$all_contours" == "true" ]] || path_changed "$changed_path" || continue
  log "Changed contour: $name"
  case "$mode" in
    fast) run_command "$cwd" "$fast_command" ;;
    full)
      run_command "$cwd" "$full_command"
      run_command "$cwd" "$compare_command"
      ;;
    audit) run_command "$cwd" "$audit_command" ;;
  esac
done

log "PASS: $mode verification against $base"
