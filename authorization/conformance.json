{
  "policyVersion": "2026-09-22.2",
  "cases": [
    {
      "name": "viewer reads documentation",
      "principal": {
        "type": "user",
        "actorId": "u1",
        "projectId": "p1",
        "projectRole": "viewer"
      },
      "permission": "documentation:read",
      "allowed": true
    },
    {
      "name": "viewer cannot write documentation",
      "principal": {
        "type": "user",
        "actorId": "u1",
        "projectId": "p1",
        "projectRole": "viewer"
      },
      "permission": "documentation:write",
      "allowed": false
    },
    {
      "name": "editor writes documentation",
      "principal": {
        "type": "user",
        "actorId": "u2",
        "projectId": "p1",
        "projectRole": "editor"
      },
      "permission": "documentation:write",
      "allowed": true
    },
    {
      "name": "maintainer manages members",
      "principal": {
        "type": "user",
        "actorId": "u3",
        "projectId": "p1",
        "projectRole": "maintainer"
      },
      "permission": "members:add",
      "allowed": true
    },
    {
      "name": "owner archives project",
      "principal": {
        "type": "user",
        "actorId": "u4",
        "projectId": "p1",
        "projectRole": "owner"
      },
      "permission": "project:archive",
      "allowed": true
    },
    {
      "name": "system admin overrides role",
      "principal": {
        "type": "user",
        "actorId": "admin",
        "projectId": "p1",
        "systemAdmin": true
      },
      "permission": "documentation:write",
      "allowed": true
    },
    {
      "name": "PAT exact read scope",
      "principal": {
        "type": "personal_access_token",
        "actorId": "u2",
        "projectId": "p1",
        "projectScopes": [
          "documentation:read"
        ],
        "projectRole": "editor",
        "personalAccessTokenId": "pat1"
      },
      "permission": "documentation:read",
      "allowed": true
    },
    {
      "name": "PAT read scope is not write",
      "principal": {
        "type": "personal_access_token",
        "actorId": "u2",
        "projectId": "p1",
        "projectScopes": [
          "documentation:read"
        ],
        "projectRole": "editor",
        "personalAccessTokenId": "pat1"
      },
      "permission": "documentation:write",
      "allowed": false
    },
    {
      "name": "PAT full documentation scopes",
      "principal": {
        "type": "personal_access_token",
        "actorId": "u2",
        "projectId": "p1",
        "projectScopes": [
          "documentation:read",
          "documentation:write"
        ],
        "projectRole": "editor",
        "personalAccessTokenId": "pat1"
      },
      "permission": "documentation:write",
      "allowed": true
    },
    {
      "name": "PAT scope cannot exceed viewer role",
      "principal": {
        "type": "personal_access_token",
        "actorId": "u1",
        "projectId": "p1",
        "projectRole": "viewer",
        "personalAccessTokenId": "pat1",
        "projectScopes": [
          "documentation:write"
        ]
      },
      "permission": "documentation:write",
      "allowed": false
    },
    {
      "name": "admin PAT still requires write scope",
      "principal": {
        "type": "personal_access_token",
        "actorId": "admin",
        "projectId": "p1",
        "systemAdmin": true,
        "personalAccessTokenId": "pat2",
        "projectScopes": [
          "documentation:read"
        ]
      },
      "permission": "documentation:write",
      "allowed": false
    }
  ]
}
