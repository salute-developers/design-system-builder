# Copy to .env.monolith for local use. Values below are development-only placeholders.
MONOLITH_IMAGE=dsbuilder-backend-monolith:dev
MONOLITH_PUBLIC_PORT=8080
MONOLITH_STARTUP_TIMEOUT_SECONDS=180
MONOLITH_MEMORY_LIMIT=2g
MONOLITH_CPU_LIMIT=2.0
MONOLITH_PIDS_LIMIT=512

DB_SERVICE_POSTGRES_DB=db_service
DB_SERVICE_POSTGRES_USER=db_service
DB_SERVICE_POSTGRES_PASSWORD=db_service
PROJECTS_POSTGRES_DB=projects_service
PROJECTS_POSTGRES_USER=projects
PROJECTS_POSTGRES_PASSWORD=projects
DOCUMENTATION_POSTGRES_DB=documentation_service
DOCUMENTATION_POSTGRES_USER=documentation
DOCUMENTATION_POSTGRES_PASSWORD=documentation

KEYCLOAK_REALM=dsbuilder
KEYCLOAK_AUDIENCE=dsbuilder-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_CLIENT_ID=dsbuilder-web
OIDC_REDIRECT_URI=http://localhost:5173/*
OIDC_WEB_ORIGIN=http://localhost:5173
PROJECTS_IDENTITY_KEYCLOAK_CLIENT_ID=projects-service
PROJECTS_IDENTITY_KEYCLOAK_CLIENT_SECRET=projects-service-secret

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
DOCUMENTATION_S3_REGION=us-east-1
DOCUMENTATION_S3_BUCKET=documentation-bundles
DOCUMENTATION_S3_PREFIX=raw
DOCUMENTATION_WORKER_ENABLED=true

JAVA_OPTS=-Xms256m -Xmx768m -XX:MaxRAMPercentage=70
NODE_OPTIONS=--max-old-space-size=384
GATEWAY_PROXY_TIMEOUT_SECONDS=300
DOCUMENTATION_MAX_REQUEST_SIZE=101m

# Production delivery uses these variables with docker-compose.monolith.prod.yml.
REGISTRY_HOST=ghcr.io
REGISTRY_NAMESPACE=replace-me
IMAGE_TAG=dev
